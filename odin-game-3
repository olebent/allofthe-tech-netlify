<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bug Invaders</title>
  <style>
    body {
      margin: 0;
      text-align: center;
      background-color: #000;
      color: #fff;
      font-family: sans-serif;
      overflow: hidden;
    }
    canvas {
      background: #111;
      display: block;
      margin: 0 auto;
      touch-action: none; /* Forhindrer standard zoom/scroll på berøringsskjermer */
    }
    /* Valgfritt: stil for toast-meldingen, men vi tegner den direkte på canvas */
  </style>
</head>
<body>
  <canvas id="gameCanvas" width="480" height="640"></canvas>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = "24px sans-serif";

    // Toast-melding (vises øverst i spillet)
    let toast = { text: "", expiry: 0 };
    function showToast(message, duration) {
      toast.text = message;
      toast.expiry = performance.now() + duration;
    }

    // Spilleren (viking) med økt hitbox og bevegelseshastighet
    const player = {
      x: canvas.width / 2,
      y: canvas.height - 30,
      width: 40,  // økt hitbox
      height: 40,
      speed: 10,  // økt bevegelse
      emoji: "🧔"
    };

    let playerShots = [];
    let monsterShots = [];

    // Monster-innstillinger
    let monsters = [];
    const monsterRows = 3;
    const monsterCols = 6;
    const monsterSpacingX = 60;
    const monsterSpacingY = 50;
    const monsterStartX = 50;
    const monsterStartY = 30;
    let monsterSpeed = 1;      // grunnleggende horisontal hastighet
    let monsterDirection = 1;  // 1 = til høyre, -1 = til venstre

    let monstersDestroyed = 0;
    let halfDestroyedTriggered = false;
    
    let level = 1; // startnivå

    // For monster-skyting
    let monsterShootInterval = 1000; // i millisekunder
    let lastMonsterShootTime = 0;

    // Hastighetsøkning etter at halvparten av monsterne er ødelagt i nivå 1
    let speedMultiplier = 1;

    // Emoji-alternativer for annethvert monster (bortsett fra de som er 👾)
    const alternateEmojis = ["💩", "🤖", "👻", "💀", "🐙", "🧟", "🧛"];

    // Initialiserer monsterene i et grid med veksling av emoji
    function initMonsters() {
      monsters = [];
      const totalMonstre = monsterRows * monsterCols;
      for (let i = 0; i < totalMonstre; i++) {
        let row = Math.floor(i / monsterCols);
        let col = i % monsterCols;
        let emoji;
        if (i % 2 === 0) {
          emoji = "👾";
        } else {
          emoji = alternateEmojis[Math.floor(i / 2) % alternateEmojis.length];
        }
        monsters.push({
          x: monsterStartX + col * monsterSpacingX,
          y: monsterStartY + row * monsterSpacingY,
          width: 32,
          height: 32,
          emoji: emoji
        });
      }
    }
    initMonsters();

    // Variabler for bevegelse
    let moveLeft = false;
    let moveRight = false;

    // --- Kontroll med tastatur ---
    window.addEventListener('keydown', (e) => {
      if (e.key === "ArrowLeft") moveLeft = true;
      if (e.key === "ArrowRight") moveRight = true;
    });
    window.addEventListener('keyup', (e) => {
      if (e.key === "ArrowLeft") moveLeft = false;
      if (e.key === "ArrowRight") moveRight = false;
    });

    // --- Kontroll med museklikk på canvas ---
    canvas.addEventListener('mousedown', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      if (x < canvas.width / 2) {
        moveLeft = true;
      } else {
        moveRight = true;
      }
    });
    canvas.addEventListener('mouseup', () => {
      moveLeft = false;
      moveRight = false;
    });

    // --- Kontroll med berøring: venstre halvdel = beveg venstre, høyre halvdel = beveg høyre ---
    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      // Sjekk alle berøringer
      for (let touch of e.touches) {
        const x = touch.clientX - rect.left;
        if (x < canvas.width / 2) {
          moveLeft = true;
        } else {
          moveRight = true;
        }
      }
    });
    canvas.addEventListener('touchend', (e) => {
      // Når berøringer fjernes, stopp bevegelsen
      if (e.touches.length === 0) {
        moveLeft = false;
        moveRight = false;
      }
    });

    // Spillerskudd: Legg til et nytt skudd fra spilleren
    function shoot() {
      playerShots.push({
        x: player.x,
        y: player.y - player.height / 2,
        width: 4,
        height: 10,
        speed: 7 * speedMultiplier
      });
    }

    // Automatisk skyting hvert 500 ms
    setInterval(shoot, 500);

    // Spill-løkken
    function gameLoop(timestamp) {
      update(timestamp);
      draw();
      requestAnimationFrame(gameLoop);
    }

    function update(timestamp) {
      // Oppdater spillerens posisjon basert på kontrollene
      if (moveLeft) {
        player.x -= player.speed;
        if (player.x < 0) player.x = 0;
      }
      if (moveRight) {
        player.x += player.speed;
        if (player.x > canvas.width) player.x = canvas.width;
      }

      // Oppdater spillerens skudd (beveg oppover)
      for (let i = playerShots.length - 1; i >= 0; i--) {
        const shot = playerShots[i];
        shot.y -= shot.speed;
        if (shot.y < 0) {
          playerShots.splice(i, 1);
        }
      }

      // Oppdater monstrets skudd (beveg nedover)
      for (let i = monsterShots.length - 1; i >= 0; i--) {
        const shot = monsterShots[i];
        shot.y += shot.speed;
        if (shot.y > canvas.height) {
          monsterShots.splice(i, 1);
        }
      }

      // Beveg monsterne horisontalt
      let hitEdge = false;
      monsters.forEach(monster => {
        monster.x += monsterSpeed * speedMultiplier * monsterDirection;
        if (monster.x < 0 || monster.x + monster.width > canvas.width) {
          hitEdge = true;
        }
      });
      // Hvis ett eller flere monstre treffer rammen, snu retning og flytt dem nedover
      if (hitEdge) {
        monsterDirection = -monsterDirection;
        monsters.forEach(monster => {
          monster.y += 20 * speedMultiplier;
        });
      }

      // La et tilfeldig monster skyte lyn ned mot spilleren
      if (timestamp - lastMonsterShootTime > monsterShootInterval / speedMultiplier) {
        if (monsters.length > 0) {
          let shooter = monsters[Math.floor(Math.random() * monsters.length)];
          monsterShots.push({
            x: shooter.x,
            y: shooter.y + shooter.height / 2,
            width: 4,
            height: 10,
            speed: 5 * speedMultiplier,
            emoji: "⚡"
          });
        }
        lastMonsterShootTime = timestamp;
      }

      // Sjekk kollisjon mellom spillerens skudd og monsterne
      for (let i = playerShots.length - 1; i >= 0; i--) {
        const shot = playerShots[i];
        for (let j = monsters.length - 1; j >= 0; j--) {
          const monster = monsters[j];
          if (collision(shot, monster)) {
            monsters.splice(j, 1);
            playerShots.splice(i, 1);
            monstersDestroyed++;
            // Når halvparten av monsterne er ødelagt i nivå 1:
            if (!halfDestroyedTriggered && monstersDestroyed >= (monsterRows * monsterCols) / 2 && level === 1) {
              halfDestroyedTriggered = true;
              speedMultiplier = 1.5; // øk hastigheten
              showToast("Nå ble Odin sint, så nå går det fortere!", 3000);
            }
            break;
          }
        }
      }

      // Sjekk om et monstrets skudd treffer spilleren (bruker utvidet hitbox)
      for (let i = monsterShots.length - 1; i >= 0; i--) {
        const shot = monsterShots[i];
        if (collision(shot, player)) {
          showToast("Game Over! Du ble truffet av lynet.", 3000);
          setTimeout(resetGame, 3000);
          return;
        }
      }

      // Sjekk om et monster har nådd bunnen
      for (let i = 0; i < monsters.length; i++) {
        if (monsters[i].y + monsters[i].height > canvas.height) {
          showToast("Game Over! Monstrene nådde bakken.", 3000);
          setTimeout(resetGame, 3000);
          return;
        }
      }

      // Nivåbytte: Når alle monsterne er ødelagt
      if (monsters.length === 0) {
        if (level === 1) {
          level = 2;
          // Øk monsterhastigheten med 2% for nivå 2
          monsterSpeed *= 1.02;
          // Tilbakestill variabler for nivå 2
          monstersDestroyed = 0;
          halfDestroyedTriggered = false;
          speedMultiplier = 1;
          initMonsters();
          showToast("Nivå 2! Monstrene er 2% raskere!", 3000);
        } else if (level === 2) {
          showToast("Gratulerer, du vant!", 3000);
          setTimeout(resetGame, 3000);
          return;
        }
      }
    }

    // Tegn alle elementene
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Tegn spilleren (viking)
      ctx.fillText(player.emoji, player.x, player.y);

      // Tegn monsterne
      monsters.forEach(monster => {
        ctx.fillText(monster.emoji, monster.x, monster.y);
      });

      // Tegn spillerens skudd (spyd)
      playerShots.forEach(shot => {
        ctx.fillStyle = "#FFF";
        ctx.fillRect(shot.x - shot.width / 2, shot.y - shot.height, shot.width, shot.height);
      });
      ctx.fillStyle = "#FFF";

      // Tegn monstrets skudd (lyn)
      monsterShots.forEach(shot => {
        ctx.fillText(shot.emoji, shot.x, shot.y);
      });

      // Tegn toast-meldingen dersom den er aktiv
      if (performance.now() < toast.expiry && toast.text) {
        ctx.fillStyle = "#FFD700";
        ctx.font = "20px sans-serif";
        ctx.fillText(toast.text, canvas.width / 2, 30);
        ctx.font = "24px sans-serif";
        ctx.fillStyle = "#FFF";
      }
    }

    // Enkel rektangulær kollisjonsdeteksjon
    function collision(a, b) {
      return a.x < b.x + b.width &&
             a.x + a.width > b.x &&
             a.y < b.y + b.height &&
             a.y + a.height > b.y;
    }

    // Tilbakestill spillet ved game over eller ved fullført spill
    function resetGame() {
      player.x = canvas.width / 2;
      playerShots = [];
      monsterShots = [];
      monstersDestroyed = 0;
      halfDestroyedTriggered = false;
      speedMultiplier = 1;
      monsterSpeed = 1; // tilbakestill hastigheten for nivå 1
      level = 1;
      initMonsters();
      toast.text = "";
    }

    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
